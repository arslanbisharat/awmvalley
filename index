    <script>
        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // AI Simulator Logic
        function setPrompt(text) {
            document.getElementById('ai-prompt-input').value = text;
        }

        async function runAiSimulation() {
            const input = document.getElementById('ai-prompt-input').value.trim();
            const outputEl = document.getElementById('ai-output');
            const statusEl = document.getElementById('ai-status');
            const btn = document.getElementById('ai-btn');

            if (!input) {
                outputEl.innerText = "// Error: Please enter a query or select a sample prompt.";
                return;
            }

            btn.disabled = true;
            statusEl.innerHTML = '● Processing...';
            statusEl.className = 'text-xs font-mono text-amber-400';
            outputEl.innerText = '';

            let result = `[AWMVALLEY-CORE] Query received: "${input}"\n\n`;
            if (input.toLowerCase().includes('financial') || input.toLowerCase().includes('risk')) {
                result += `> Analyzing Q3 fiscal variance across 12 ledger nodes...\n> Anomaly detected in operational expenditures (-3.8%).\n> Recommendation: Deploy autonomous invoice reconciliation agents. Confidence: 99.4%.`;
            } else if (input.toLowerCase().includes('python') || input.toLowerCase().includes('microservice')) {
                result += `> Generating FastAPI Data Ingestion Microservice:\n\`\`\`python\nfrom fastapi import FastAPI\n\napp = FastAPI(title="AWMVALLEY-Ingest")\n\n@app.post("/v1/telemetry")\nasync def ingest(payload: dict):\n    return {"status": "success", "processed_records": len(payload)}\n\`\`\``;
            } else {
                result += `> Synthesizing contextual vector embeddings...\n> Retrieved 14 relevant enterprise knowledge fragments.\n> Result: Processed with optimal latency (11ms). All tenant security guardrails verified.`;
            }

            let i = 0;
            function typeWriter() {
                if (i < result.length) {
                    outputEl.innerText += result.charAt(i);
                    i++;
                    setTimeout(typeWriter, 10);
                } else {
                    btn.disabled = false;
                    statusEl.innerHTML = '● Ready';
                    statusEl.className = 'text-xs font-mono text-emerald-400';
                }
            }
            typeWriter();
        }

        // Contact Form Handling
        function handleFormSubmit(e) {
            e.preventDefault();
            const alertBox = document.getElementById('form-success-alert');
            alertBox.classList.remove('hidden');
            document.getElementById('contact-form').reset();
            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 6000);
        }
    </script>
